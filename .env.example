# ── IBKR Login (for IB Gateway container) ──────────────────────────────────────
IBKR_USERNAME=your_ibkr_username
IBKR_PASSWORD=your_ibkr_password

# paper | live  — also controls which port IB Gateway exposes
TRADING_MODE=paper

# ── IB Gateway connection (from the bot's perspective) ─────────────────────────
IB_HOST=ib-gateway       # Docker service name — don't change for docker-compose
IB_PORT=4004             # 4004 = paper, 4002 = live  (must match TRADING_MODE)
IB_CLIENT_ID=1           # Change if another bot is already using client id 1

# ── Webhook security ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 24
# Put the same value in every TradingView alert JSON body as "token".
SECRET_TOKEN=change_me_to_a_long_random_string

# ── Position sizing (fraction of IBKR equity, not a Kraken ledger) ─────────────
POSITION_SIZE_PCT=0.10       # 10% of equity per buy
MAX_POSITION_SIZE_PCT=0.50   # Hard cap (safety ceiling)
SELL_PCT=1.0                 # Fraction of the long /lb-sell closes

# ── Exchange / currency ─────────────────────────────────────────────────────────
# US stocks:   EXCHANGE=SMART   CURRENCY=USD
# ASX stocks:  EXCHANGE=ASX     CURRENCY=AUD     (BHP, CBA, …)
EXCHANGE=ASX
CURRENCY=AUD

# ── Market hours ────────────────────────────────────────────────────────────────
# Orders are rejected outside this window (there is no arm window to hold them).
# A daily bar-close alert that lands a minute after the bell will fail.
# NYSE/NASDAQ:  MARKET_TZ=America/New_York  MARKET_OPEN=09:30  MARKET_CLOSE=16:00
# ASX:          MARKET_TZ=Australia/Sydney  MARKET_OPEN=10:00  MARKET_CLOSE=16:00
MARKET_TZ=Australia/Sydney
MARKET_OPEN=10:00
MARKET_CLOSE=16:00

# Optional. market (default) is blocked outside the window above.
# limit allows outside-RTH orders with LIMIT_SLIPPAGE_PCT (default 0.005).
# ORDER_TYPE=market
# LIMIT_SLIPPAGE_PCT=0.005

# ── Trailing stop ───────────────────────────────────────────────────────────────
TRAILING_STOP_PCT=0.05       # 5% pullback from peak closes the long (0 = disabled)
MONITOR_INTERVAL_SECONDS=30

# ── Cooldown ────────────────────────────────────────────────────────────────────
COOLDOWN_SECONDS=0           # Wait after a close before the next /lb-buy (0 = off)

# ── Docker network for the existing Cloudflare tunnel ──────────────────────────
# cloudflared must share this network so ibkr.ballzac.uk can target iadss-ibkr:5005.
# This is the same network the Kraken tracker uses. Do not point that hostname here.
DOCKER_NETWORK=ballzac

# ── Telegram (optional, separate messages from the Kraken bot) ─────────────────
# Lines are prefixed "IADSS IBKR" so they are not the Kraken "IADSS BUY executed" alerts.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
